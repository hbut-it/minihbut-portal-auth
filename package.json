{
  "name": "hbut-auth",
  "version": "1.0.0",
  "description": "A auth tool for HBUT new portal",
  "private": true,
  "egg": {
    "declarations": true
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "egg": "^3.17.5",
    "egg-scripts": "2",
    "egg-validate": "^2.0.2"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "egg-bin": "6",
    "egg-mock": "5",
    "eslint": "8",
    "eslint-config-egg": "13"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "egg-scripts start --title=egg-server-hbut-auth",
    "stop": "egg-scripts stop --title=egg-server-hbut-auth",
    "dev": "egg-bin dev",
    "test": "npm run lint -- --fix && npm run test:local",
    "test:local": "egg-bin test",
    "cov": "egg-bin cov",
    "lint": "eslint .",
    "ci": "npm run lint && npm run cov"
  },
  "repository": {
    "type": "git",
